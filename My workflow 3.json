    {
      "parameters": {
        "jsCode": "const action = $('Convert to Json').first().json.output.action;\nconst details = $('Convert to Json').first().json.output.details;\nconst available = $('Is Available?').first().json.available;\n\nlet response = \"\";\n\nif (action === \"appoint\") {\n  if (!details.Name || !details.Email || !details.Time) {\n    const missing = [];\n    if (!details.Name) missing.push(\"Name\");\n    if (!details.Email) missing.push(\"Email\");\n    if (!details.Time) missing.push(\"Time\");\n\n    response = `Provide missing details: ${missing.join(\", \")}.`;\n  } else if (!available) {\n    response = \"The selected time is not available. Choose another time.\";\n  } else {\n    response = `Your appointment has been scheduled for ${details.Time}.`;\n  }\n}\n\nelse if (action === \"avail_check\") {\n  if (!details.Time) {\n    response = \"Specify a time to check availability.\";\n  } else if (available) {\n    response = \"The selected time is available.\";\n  } else {\n    response = \"The selected time is not available.\";\n  }\n}\n\nreturn [{ response }];"
      },
