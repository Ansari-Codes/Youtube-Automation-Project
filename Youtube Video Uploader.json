      ],
      "id": "9b6e4fae-c0dd-49be-841f-7904416a3993",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const scenes = $input.first().json;\nconst sceneArray = [];\n\nfor (const key in scenes) {\n  sceneArray.push({\n    sceneName: key,\n    ...scenes[key]\n  });\n}\n\nreturn sceneArray;"
      },
